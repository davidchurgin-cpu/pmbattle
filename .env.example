PMBATTLE_ADDR=:8080
PMBATTLE_DB=pmbattle.db
PMBATTLE_SCHEDULE_URL=http://linefeednew.spankodds.com/supportSystem/rawschedule_v2_expanded.xml
PMBATTLE_SCHEDULE_INTERVAL=30s
PMBATTLE_MARKET_INTERVAL=5m
PMBATTLE_KALSHI_ENV=demo
PMBATTLE_KALSHI_KEY_ID=
PMBATTLE_KALSHI_PRIVATE_KEY_PATH=
PMBATTLE_SIMULATED=true
PMBATTLE_TRADING_ENABLED=false
# Browser sign-in password, at least 8 characters. Required whenever
# PMBATTLE_TRADING_ENABLED=true. Strongly recommended at all other times.
